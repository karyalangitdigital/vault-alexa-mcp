# VaultAlexa+ Environment Configuration
# Copy this file to .env and fill in real values
# ⚠️ NEVER commit .env to version control!

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MCP Protocol ─────────────────────────────────────────────────────────────
MCP_PROTOCOL_VERSION=2025-11-25

# ─── AWS Configuration ────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ─── Amazon DynamoDB ──────────────────────────────────────────────────────────
DYNAMODB_TABLE=PrimeVaultLedger

# ─── Amazon Selling Partner API ───────────────────────────────────────────────
AMAZON_SP_API_CLIENT_ID=your_sp_api_client_id
AMAZON_SP_API_CLIENT_SECRET=your_sp_api_client_secret
AMAZON_SP_API_REFRESH_TOKEN=your_refresh_token

# ─── Google Gemini AI (Multimodal Vision for Product Listing) ─────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Alexa+ Skill ─────────────────────────────────────────────────────────────
ALEXA_SKILL_ID=amzn1.ask.skill.your-skill-id

# ─── Local Demo Only (no external services needed) ────────────────────────────
# Leave all above empty to run the web simulator in offline/mock mode.
# The app works fully without any API keys using simulated data.
