{
  "$schema": "https://json.schemastore.org/mcp.json",
  "name": "vault-alexa-mcp",
  "version": "2.5.0",
  "description": "VaultAlexa+ Enterprise Financial AI Agent & Autonomous Amazon Shopping MCP Server — 15 tools, Buyer & Seller dual-agent, Bilingual EN/ID",
  "protocolVersion": "2025-11-25",
  "author": "KARYA LANGIT Digital (Supriadi) — Amazon Developer Hackathon 2026 Alexa+ Track",
  "mcpServers": {
    "vault-alexa": {
      "command": "node",
      "args": [
        "mcp-server.js"
      ],
      "env": {
        "PORT": "3000",
        "NODE_ENV": "production",
        "MCP_PROTOCOL_VERSION": "2025-11-25",
        "AWS_REGION": "us-east-1",
        "DYNAMODB_TABLE": "PrimeVaultLedger"
      },
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:3000/mcp/v1/rpc",
        "sseUrl": "http://localhost:3000/mcp/v1/sse"
      }
    }
  },
  "capabilities": {
    "tools": {
      "listChanged": true
    },
    "resources": {
      "subscribe": true,
      "listChanged": true
    },
    "prompts": {
      "listChanged": true
    },
    "logging": {}
  },
  "alexaPlusIntegration": {
    "skillId": "amzn1.ask.skill.vault-alexa-plus-2026",
    "endpointUri": "https://vault-alexa-mcp.aws.amazon.com/mcp/v1/rpc",
    "supportedIntents": [
      "CheckBudgetIntent",
      "SafePurchaseIntent",
      "AmazonDealSearchIntent",
      "SplitBillIntent",
      "PriceDropSniperIntent",
      "ProactiveRunwayForecastIntent",
      "InitiatePurchaseDisputeIntent",
      "PeerSplitRequestIntent",
      "DynamicNegotiateIntent",
      "OpportunityCostIntent",
      "MorningBriefingIntent",
      "InventoryStockoutForecastIntent",
      "LogTransactionIntent",
      "AnalyzeProductImageIntent",
      "PublishSellerProductIntent"
    ]
  },
  "amazonBedrockAgent": {
    "agentName": "VaultAlexaBedrockAgent",
    "foundationModel": "anthropic.claude-3-5-sonnet-20241022-v2:0",
    "actionGroups": [
      {
        "actionGroupName": "MCP_Tools_Action_Group",
        "apiSchema": "openapi-3.0",
        "executionType": "LAMBDA"
      }
    ]
  }
}
